# wiki-kit web tier (HANDOFF §8). Same URL, two representations:
#   path ends .md  -> raw file from /bundles (agents)
#   otherwise      -> Quartz-built HTML from /site (humans)
# Listens on the compose network only; cloudflared is the way in (step 9).
:8080 {
	@git path_regexp \.git(/|$)
	respond @git 404

	# X-Wiki-User is only ever what Cloudflare Access authenticated; a
	# client-supplied value is dropped, then rewritten from the Cf header.
	handle /mcp* {
		reverse_proxy mcp:8081 {
			header_up -X-Wiki-User
			header_up X-Wiki-User {header.Cf-Access-Authenticated-User-Email}
		}
	}

	handle /status {
		root * /state
		rewrite * /status.json
		file_server
	}

	@markdown path *.md
	handle @markdown {
		root * /bundles
		file_server
	}

	handle {
		root * /site
		try_files {path} {path}/index.html {path}.html
		file_server
	}
}
